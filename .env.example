# Required for live film search and official poster paths.
# Supports either the short v3 API key or the long API Read Access Token.
# Create one at https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# Required for IMDb ratings. Create a key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Required for the shared Supabase watchlist and Realtime updates.
# Vercel can populate the URL and publishable key through the Supabase integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin used for Supabase email confirmation redirects.
# Use http://localhost:3000 locally and the canonical HTTPS URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
